{
  "name": "2c8-mcp-server",
  "version": "1.1.0",
  "description": "Methodology-driven MCP server for consuming and creating 2c8 process models",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "2c8-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/index.ts --http",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/406olsson/2c8-mcp-server.git"
  },
  "keywords": [
    "mcp",
    "2c8",
    "modeling",
    "ai-agent"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^18.0.10",
    "express": "^5.2.1",
    "pdf-parse": "^2.4.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.13.10",
    "@types/pdf-parse": "^1.1.5",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
