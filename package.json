{
  "name": "modelm8",
  "version": "1.3.0",
  "description": "modelM8 — methodology-driven MCP server for consuming and creating 2c8 process models",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "modelm8": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/index.ts --http",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome check --write .",
    "ci": "npm run typecheck && npm run lint && npm run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janolss/modelM8.git"
  },
  "bugs": {
    "url": "https://github.com/janolss/modelM8/issues"
  },
  "homepage": "https://github.com/janolss/modelM8#readme",
  "author": "janolss",
  "keywords": [
    "mcp",
    "2c8",
    "modelM8",
    "modeling",
    "ai-agent"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "pdf-parse": "^2.4.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/express": "^5.0.3",
    "@types/node": "^26.6.6",
    "@types/pdf-parse": "^1.1.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
