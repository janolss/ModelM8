# Base URL of your 2c8 MT backend (no trailing slash required)
TWO_C8_BASE_URL=https://your-server.example/mt-backend

# API key sent as x-api-key
TWO_C8_API_KEY=replace-me

# When false (default), only read/analysis/propose tools are registered.
# Set to true to also register create/update tools (incl. create_repository, apply_model_proposal).
TWO_C8_ALLOW_WRITES=false

# When false (default), delete_model / delete_symbol / delete_mt_document are not registered.
# Independent of ALLOW_WRITES. Set true only in sandboxes where irreversible delete is acceptable.
TWO_C8_ALLOW_DELETES=false

# draft (default) creates models via draft repository; direct writes to target repo.
# Use direct for sandbox repos such as "Utveckling MCP".
TWO_C8_WRITE_MODE=draft

# Write scope: runtime lock to one repositoryId (no new container per repo).
# Default: require lock before writes; auto-lock after create_repository.
TWO_C8_WRITE_REQUIRE_LOCK=true
TWO_C8_WRITE_AUTO_LOCK_ON_CREATE=true
# Unlock policy: confirm_phrase (default) | restart | open
TWO_C8_WRITE_UNLOCK_MODE=confirm_phrase
# Required for confirm_phrase unlock (operator-only; do not put in agent prompts)
# TWO_C8_WRITE_UNLOCK_PHRASE=change-me
# Optional permanent deny lists (comma-separated)
# TWO_C8_WRITE_DENY_REPOSITORY_IDS=
# TWO_C8_WRITE_DENY_REPOSITORY_NAMES=Inera IMS,Lättkrängt IMS,Utveckling MCP

# Transport: stdio (default) or http
MCP_TRANSPORT=http

# HTTP listen settings (used when MCP_TRANSPORT=http or --http)
PORT=3000
HOST=127.0.0.1

# Required when exposing HOST beyond loopback: Bearer token for POST /mcp.
# Clients send: Authorization: Bearer <token>
# MCP_HTTP_AUTH_TOKEN=change-me

# Optional extra filesystem roots for get_document_content file:// reads
# (in addition to repository document roots with file:/// values).
# TWO_C8_DOCUMENT_READ_ROOTS=/absolute/path/to/docs,/other/library

# Optional override for methodology knowledge pack directory
# KNOWLEDGE_DIR=/absolute/path/to/knowledge
